PORT=3000
# Existing Docker network shared with the reverse proxy and other services.
WEB_NETWORK=web_network
PUBLIC_BASE_URL=https://addon.example.com
NGUONC_API_BASE_URL=https://phim.nguonc.com/api/
REQUEST_TIMEOUT_MS=8000
# Time to wait for an HLS playlist or segment from the upstream CDN.
HLS_REQUEST_TIMEOUT_MS=25000
# Renew a StreamC playlist grant this many milliseconds before it expires.
HLS_REFRESH_BEFORE_EXPIRY_MS=120000
CATALOG_CACHE_TTL_MS=300000
DETAIL_CACHE_TTL_MS=900000
STREAM_CACHE_TTL_MS=900000
# Number of HLS media segments to fetch ahead after playback starts or seeks.
HLS_PREFETCH_SEGMENTS=15
# Maximum number of concurrent HLS segment downloads across all sessions.
HLS_PREFETCH_CONCURRENCY=3
# Shared upper bound for prefetched, unused HLS segment data (1 GiB).
HLS_PREFETCH_CACHE_BYTES=1073741824
# Discard unused prefetched segments after 30 minutes.
HLS_CACHE_IDLE_TTL_MS=1800000
